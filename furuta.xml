<mujoco model="furuta">

  <compiler angle="radian"/>

  <option timestep="0.004" integrator="RK4" gravity="0 0 -9.81"/>

  <default>
    <geom contype="0" conaffinity="0"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.85 0.85 0.85" rgb2="0.75 0.75 0.75" width="300" height="300"/>
    <material name="floor_mat" texture="grid" texrepeat="4 4" reflectance="0.1"/>
    <material name="base_mat" rgba="0.18 0.18 0.20 1"/>
    <material name="motor_mat" rgba="0.10 0.10 0.11 1"/>
    <material name="arm_mat" rgba="0.72 0.74 0.78 1"/>
    <material name="collar_mat" rgba="0.55 0.56 0.60 1"/>
    <material name="pendulum_mat" rgba="0.85 0.15 0.15 1"/>
    <material name="bob_mat" rgba="0.95 0.75 0.05 1"/>
  </asset>

  <worldbody>

    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 3" dir="0 0 -1"/>

    <geom name="floor" type="plane" size="1 1 0.05" material="floor_mat"/>

    <!-- Fixed base: plate + corner feet + vertical post + motor housing.
         Shaft top (where arm_joint mounts) sits at world z=0.212. -->
    <body name="base" pos="0 0 0">
      <geom name="base_plate" type="box" size="0.09 0.12 0.008" pos="0 0 0.008" material="base_mat"/>
      <geom name="foot1" type="cylinder" size="0.006 0.008" pos=" 0.075  0.105 0.008" material="collar_mat"/>
      <geom name="foot2" type="cylinder" size="0.006 0.008" pos="-0.075  0.105 0.008" material="collar_mat"/>
      <geom name="foot3" type="cylinder" size="0.006 0.008" pos=" 0.075 -0.105 0.008" material="collar_mat"/>
      <geom name="foot4" type="cylinder" size="0.006 0.008" pos="-0.075 -0.105 0.008" material="collar_mat"/>

      <geom name="base_post" type="cylinder" size="0.018 0.086" pos="0 0 0.102" material="base_mat"/>
      <geom name="post_gusset" type="box" size="0.022 0.03 0.006" pos="0 0.03 0.024" euler="35 0 0" material="base_mat"/>

      <geom name="motor_housing" type="box" size="0.028 0.028 0.032" pos="0 0 0.22" material="motor_mat"/>
      <geom name="motor_cap" type="cylinder" size="0.014 0.006" pos="0 0 0.194" material="collar_mat"/>

      <!-- arm_joint: hinge about world Z, at the top of the shaft. -->
      <body name="arm" pos="0 0 0.212">
        <joint name="arm_joint" type="hinge" axis="0 0 1" pos="0 0 0"
               damping="0.001" frictionloss="0.001"/>

        <geom name="arm_collar" type="cylinder" size="0.012 0.010" material="collar_mat" density="2700"/>
        <geom name="arm_rod" type="cylinder" fromto="-0.15 0 0  0.15 0 0" size="0.006" material="arm_mat" density="2700"/>
        <geom name="arm_cap_neg" type="sphere" size="0.006" pos="-0.15 0 0" material="arm_mat" density="2700"/>

        <!-- pendulum_joint: hinge about the arm's local Y (tangential),
             mounted at the rod tip, radius 0.15 from arm_joint. -->
        <body name="pendulum" pos="0.15 0 0">
          <joint name="pendulum_joint" type="hinge" axis="0 1 0" pos="0 0 0"
                 damping="0.0005" frictionloss="0.0002"/>

          <geom name="pend_hub" type="cylinder" size="0.010 0.009" quat="0.7071068 0.7071068 0 0" material="collar_mat" density="2976"/>
          <geom name="pend_rod" type="cylinder" fromto="0 0 0  0 0 -0.125" size="0.004" material="pendulum_mat" density="2976"/>
          <geom name="pend_bob" type="sphere" size="0.013" pos="0 0 -0.125" material="bob_mat" density="2976"/>
        </body>
      </body>
    </body>

  </worldbody>

  <actuator>
    <motor name="motor" joint="arm_joint" ctrlrange="-1 1" gear="1"/>
  </actuator>

</mujoco>
